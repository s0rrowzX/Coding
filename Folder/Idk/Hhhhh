-- ============================================================
-- CREATE ROLE DISPLAY ABOVE HEAD
-- ============================================================
local function createRoleDisplay(player)
    if not player or player == game.Players.LocalPlayer then return end
    if not player.Character then return end
    
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    
    -- DETECT ROLE
    local role = detectRole(player)
    local color = ROLE_COLORS[role] or CONFIG.TextColor
    
    -- Clean up old display if it exists
    local old = head:FindFirstChild("RoleDisplay")
    if old then old:Destroy() end
    
    -- Create new BillboardGui
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "RoleDisplay"
    billboard.Adornee = head
    billboard.Size = UDim2.new(0, 220, 0, 45)
    billboard.StudsOffset = Vector3.new(0, CONFIG.OffsetY, 0)
    billboard.AlwaysOnTop = true
    billboard.ResetOnSpawn = false
    billboard.Parent = head
    
    -- Background Frame
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = CONFIG.BackgroundColor
    bg.BackgroundTransparency = 0.6
    bg.BorderSizePixel = 0
    bg.Parent = billboard
    Instance.new("UICorner").Parent = bg
    
    -- Color Outline
    local outline = Instance.new("UIStroke")
    outline.Color = color
    outline.Thickness = 2
    outline.Parent = bg
    
    -- Text Label
    local text = Instance.new("TextLabel")
    text.Size = UDim2.new(1, 0, 1, 0)
    text.BackgroundTransparency = 1
    text.Text = "🎭 " .. role
    text.TextColor3 = color
    text.TextSize = CONFIG.TextSize
    text.Font = Enum.Font.GothamBold
    text.TextStrokeTransparency = 0.2
    text.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    text.Parent = bg
    
    -- Fade-in Animation
    billboard.Enabled = true
    for i = 1, 10 do
        bg.BackgroundTransparency = 0.6 - (i / 10) * 0.3
        text.TextTransparency = 1 - (i / 10)
        task.wait(0.02)
    end
    
    warn("✅ " .. player.Name .. " → ROLE: " .. role)
end

-- ============================================================
-- MAIN SCRIPT EXECUTION
-- ============================================================
local function main()
    -- Display Intro Screen
    task.spawn(showIntro)
    
    -- Function to track and update players
    local function setupPlayer(player)
        if player == game.Players.LocalPlayer then return end
        
        -- Listen for character spawns
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            createRoleDisplay(player)
        end)
        
        if player.Character then
            task.spawn(function()
                task.wait(0.5)
                createRoleDisplay(player)
            end)
        end
        
        -- Monitor attribute changes for role updates
        local monitorObjects = {"Role", "PlayerRole", "CurrentRole", "GameRole", "MyRole", "RoleName", "TeamRole", "Class"}
        for _, objName in ipairs(monitorObjects) do
            local obj = player:FindFirstChild(objName)
            if obj and obj:IsA("StringValue") then
                obj:GetPropertyChangedSignal("Value"):Connect(function()
                    createRoleDisplay(player)
                end)
            end
        end
        
        player:GetAttributeChangedSignal("Role"):Connect(function() createRoleDisplay(player) end)
        player:GetAttributeChangedSignal("PlayerRole"):Connect(function() createRoleDisplay(player) end)
        player:GetAttributeChangedSignal("CurrentRole"):Connect(function() createRoleDisplay(player) end)
    end
    
    -- Setup current players
    for _, player in ipairs(game.Players:GetPlayers()) do
        setupPlayer(player)
    end
    
    -- Setup new players when they join
    game.Players.PlayerAdded:Connect(setupPlayer)
    
    -- PERIODIC REFRESH LOOP
    while task.wait(CONFIG.UpdateInterval) do
        for _, player in ipairs(game.Players:GetPlayers()) do
            if player ~= game.Players.LocalPlayer and player.Character then
                task.spawn(function()
                    createRoleDisplay(player)
                end)
            end
        end
    end
end

-- ============================================================
-- RUN
-- ============================================================
local success, err = pcall(main)
if not success then
    warn("❌ Failed to run script: " .. tostring(err))
end
