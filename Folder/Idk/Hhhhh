-- ============================================================
-- READ ROLE FROM GAME GUI (MOST ACCURATE METHOD)
-- ============================================================
local function getRoleFromGameGUI(player)
    if not player then return nil end
    
    -- CHECK 1: From Head BillboardGui
    if player.Character then
        local head = player.Character:FindFirstChild("Head")
        if head then
            for _, child in ipairs(head:GetChildren()) do
                if child:IsA("BillboardGui") then
                    for _, guiChild in ipairs(child:GetAllChildren()) do
                        if guiChild:IsA("TextLabel") and guiChild.Text then
                            local text = guiChild.Text
                            text = text:gsub("[%z%s%p%c]", " "):gsub("%s+", " "):match("%S+")
                            if text then
                                for _, r in ipairs(ROLES) do
                                    if text:lower() == r:lower() or text:lower():find(r:lower()) then
                                        return r
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    -- CHECK 2: From PlayerGui
    if player:FindFirstChild("PlayerGui") then
        for _, gui in ipairs(player.PlayerGui:GetChildren()) do
            if gui:IsA("ScreenGui") or gui:IsA("BillboardGui") then
                for _, child in ipairs(gui:GetAllChildren()) do
                    if child:IsA("TextLabel") and child.Text then
                        local text = child.Text:gsub("[%z%s%p%c]", " "):gsub("%s+", " "):match("%S+")
                        if text then
                            for _, r in ipairs(ROLES) do
                                if text:lower() == r:lower() or text:lower():find(r:lower()) then
                                    return r
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    return nil
end

-- ============================================================
-- ROLE DETECTION FUNCTION (10 METHODS)
-- ============================================================
local function detectRole(player)
    if not player then return "Survivor" end
    
    local role = nil
    
    -- ====== METHOD 1: READ DIRECTLY FROM GAME GUI ======
    role = getRoleFromGameGUI(player)
    if role then 
        for _, r in ipairs(ROLES) do
            if role:lower() == r:lower() then return r end
        end
    end
    
    -- ====== METHOD 2: CHECK VALUE OBJECTS ======
    local objNames = {"Role", "PlayerRole", "CurrentRole", "GameRole", "MyRole", "RoleName", "TeamRole", "Class", "Job"}
    for _, name in ipairs(objNames) do
        local obj = player:FindFirstChild(name)
        if obj and (obj:IsA("StringValue") or obj:IsA("ObjectValue")) then
            role = tostring(obj.Value)
            if role then
                for _, r in ipairs(ROLES) do
                    if role:lower() == r:lower() then return r end
                end
            end
        end
    end
    
    -- ====== METHOD 3: CHECK ATTRIBUTES ======
    local attrNames = {"Role", "PlayerRole", "CurrentRole", "GameRole", "Class"}
    for _, attr in ipairs(attrNames) do
        if player:GetAttribute(attr) then
            role = tostring(player:GetAttribute(attr))
            if role then
                for _, r in ipairs(ROLES) do
                    if role:lower() == r:lower() then return r end
                end
            end
        end
    end
    
    -- ====== METHOD 4: CHECK TEAM ======
    if player.Team then
        role = player.Team.Name
        for _, r in ipairs(ROLES) do
            if role:lower() == r:lower() then return r end
        end
    end
    
    -- ====== METHOD 5: CHECK ROLES FOLDER ======
    local folderNames = {"Roles", "RoleFolder", "PlayerRoles", "Classes"}
    for _, fname in ipairs(folderNames) do
        local folder = player:FindFirstChild(fname)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                if child:IsA("StringValue") or child:IsA("ObjectValue") then
                    role = tostring(child.Value)
                    if role then
                        for _, r in ipairs(ROLES) do
                            if role:lower() == r:lower() then return r end
                        end
                    end
                end
            end
        end
    end
    
    -- ====== METHOD 6: CHECK LEADERSTATS ======
    if player:FindFirstChild("leaderstats") then
        for _, child in ipairs(player.leaderstats:GetChildren()) do
            if child:IsA("StringValue") and child.Value then
                role = child.Value
                for _, r in ipairs(ROLES) do
                    if role:lower() == r:lower() then return r end
                end
            end
        end
    end
    
    -- ====== METHOD 7: CHECK DISPLAY / PLAYER NAME ======
    for _, r in ipairs(ROLES) do
        if player.DisplayName:lower() == r:lower() then return r end
        if player.Name:lower() == r:lower() then return r end
    end
    
    -- ====== METHOD 8: CHECK CHARACTER ======
    if player.Character then
        for _, child in ipairs(player.Character:GetChildren()) do
            if child:IsA("StringValue") or child:IsA("ObjectValue") then
                if child.Value then
                    role = tostring(child.Value)
                    for _, r in ipairs(ROLES) do
                        if role:lower() == r:lower() then return r end
                    end
                end
            end
        end
    end
    
    -- ====== METHOD 9: CHECK COLLECTION SERVICE TAGS ======
    local cs = game:GetService("CollectionService")
    for _, r in ipairs(ROLES) do
        if cs:HasTag(player, r) then return r end
    end
    
    -- ====== METHOD 10: CHECK GLOBAL FOLDERS ======
    if game:FindFirstChild("PlayersRoles") then
        local rolesFolder = game.PlayersRoles
        for _, child in ipairs(rolesFolder:GetChildren()) do
            if child.Name == player.Name or child.Value == player then
                local roleObj = child:FindFirstChild("Role")
                if roleObj then
                    role = tostring(roleObj.Value)
                    for _, r in ipairs(ROLES) do
                        if role:lower() == r:lower() then return r end
                    end
                end
            end
        end
    end
    
    -- ====== FALLBACK ======
    warn("⚠️ DEBUG - Player: " .. player.Name .. " | Role NOT FOUND! Falling back to Survivor")
    return "Survivor"
end

